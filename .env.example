DATABASE_URL=
OUTSCRAPER_API_KEY=
ANTHROPIC_API_KEY=
REPLY_ADDRESS=
ADMIN_API_KEY=
APP_ORIGIN=http://localhost:3000
# SPRINT_04.md ticket 4.2. Leave unset until the Stakeholder's Postmark account + verified
# mail.reviewguide.eu sending domain exist — request-link works end-to-end without it (logs
# instead of sending); setting it starts real sends with zero code changes.
POSTMARK_TOKEN=
POSTMARK_FROM_EMAIL=alerts@mail.reviewguide.eu
POSTMARK_FROM_NAME=ReviewGuide
# Shared with reviewguide-app's server env (never its client bundle) — signs/verifies the
# session JWT from POST /api/auth/verify.
AUTH_JWT_SECRET=
